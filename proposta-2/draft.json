    "_athena_query_exemplo": "SELECT idJornada, canal, produto, ambiente, dataHoraInicio, dataHoraFim, total_erros_integracao, s3_detail_path FROM jornadas_meta WHERE data = '2024-06-15' AND total_erros_integracao > 0",
